# Copy this file to .env and fill in your actual values.
# .env is gitignored and should never be committed.

# Clerk (Authentication) — publishable key, safe to expose in frontend
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase — project URL and anon/public key, safe to expose in frontend
# (protected by Row Level Security policies on the backend)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Note: Twilio credentials (TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN,
# TWILIO_WHATSAPP_NUMBER) are NOT frontend variables. They live only
# as Supabase Edge Function secrets, set via:
#   supabase secrets set TWILIO_ACCOUNT_SID=...
#   supabase secrets set TWILIO_AUTH_TOKEN=...
#   supabase secrets set TWILIO_WHATSAPP_NUMBER=...
